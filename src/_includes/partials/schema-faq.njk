<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faqItems %}
    {
      "@type": "Question",
      "name": {{ item.q | dump }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
